# ═══════════════════════════════════════════════════════════════
# VARIÁVEIS DE AMBIENTE - Tracking e Integrações
# ⚠️ NUNCA commite valores reais! Use apenas no Vercel Dashboard.
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# SUPABASE (OBRIGATÓRIAS)
# ──────────────────────────────────────────────────────────────
# Onde obter: Painel Supabase → Settings → API
SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
PUBLIC_SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>

# ──────────────────────────────────────────────────────────────
# META/FACEBOOK (Opcional - para Pixel e CAPI)
# ──────────────────────────────────────────────────────────────
# Onde obter Pixel ID: Meta Business → Events Manager → Pixel ID
# Onde obter CAPI Token: Meta Business → Events Manager → Settings → Conversions API → Access Token
# ⚠️ IMPORTANTE: META_CAPI_ACCESS_TOKEN é server-only, nunca será exposto no client bundle
PUBLIC_FB_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# ──────────────────────────────────────────────────────────────
# PERFECTPAY WEBHOOK (TODO: Quando receber o novo webhook da PerfectPay)
# ──────────────────────────────────────────────────────────────
# TODO: Quando eu mandar o novo webhook da PerfectPay, vamos atualizar PERFECTPAY_WEBHOOK_SECRET e o endpoint
# Onde obter: Painel PerfectPay → Webhooks → Secret/Token
PERFECTPAY_WEBHOOK_SECRET=
PERFECTPAY_WEBHOOK_TOKEN=

# ──────────────────────────────────────────────────────────────
# GOOGLE ANALYTICS 4 (Opcional)
# ──────────────────────────────────────────────────────────────
# Onde obter: Google Analytics 4 → Admin → Data Streams → Measurement ID
PUBLIC_GA_ID=

# ──────────────────────────────────────────────────────────────
# SITE/CORS (Opcional - recomendado em produção)
# ──────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://seu-dominio.com
ALLOWED_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com

