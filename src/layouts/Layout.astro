---
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "Algoritmo Exclusivo de Análise Facial com IA. Descubra seu score científico de atratividade e desbloqueie seu potencial máximo de Maxxing.",
  canonicalUrl = Astro.url.href,
  ogImage = "/og-image.png"
} = Astro.props;

// ═══════════════════════════════════════════════════════════════
// CONFIGURAÇÕES - Usa variáveis de ambiente
// ═══════════════════════════════════════════════════════════════
const SITE_URL = import.meta.env.PUBLIC_SITE_URL || "https://glowmax.app";
const FB_PIXEL_ID = import.meta.env.PUBLIC_FB_PIXEL_ID?.trim() || ""; // Desligado se vazio
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_ID || "";
const TAWK_PROPERTY_ID = ""; // Adicione seu Tawk.to Property ID
const TAWK_WIDGET_ID = ""; // Adicione seu Tawk.to Widget ID

// Validação: log em dev se Pixel ID não estiver configurado
if (import.meta.env.DEV && !FB_PIXEL_ID) {
  console.log('[Meta Pixel] ⚠️ PUBLIC_FB_PIXEL_ID não configurado. Pixel não será inicializado.');
}
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="GlowMax" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preconnect to external resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://connect.facebook.net" />
    
    <!-- Preload critical fonts -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" as="style" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="GlowMax" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}${ogImage}`} />
    
    <title>{title}</title>
    
    <!-- Google Analytics 4 -->
    {GA_MEASUREMENT_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          try {
            if (typeof window !== 'undefined') {
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              window.gtag = gtag;
              try {
                gtag('js', new Date());
                gtag('config', GA_MEASUREMENT_ID, {
                  page_title: typeof document !== 'undefined' ? document.title : '',
                  page_location: typeof window !== 'undefined' && window.location ? window.location.href : '',
                });
              } catch (e) {
                console.warn('[Tracking] GA4 config error (non-critical):', e);
              }
              
              // Custom events helper
              window.trackGA4Event = function(eventName, params) {
                try {
                  if (typeof gtag === 'function') {
                    gtag('event', eventName, params);
                  }
                } catch (e) {
                  console.warn('[Tracking] GA4 event error (non-critical):', e);
                }
              };
            }
          } catch (error) {
            // Se GA4 falhar completamente, não quebra a página
            console.warn('[Tracking] GA4 initialization failed (non-critical):', error);
            if (typeof window !== 'undefined') {
              window.trackGA4Event = function() {}; // Função vazia para não quebrar chamadas
            }
          }
        </script>
      </>
    )}
    
    <!-- Facebook Pixel Code (inicializa apenas se PUBLIC_FB_PIXEL_ID estiver configurado) -->
    {FB_PIXEL_ID && (
      <>
    <script is:inline define:vars={{ FB_PIXEL_ID }}>
      try {
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        
        // Inicializar Pixel e disparar PageView (com guards)
        if (typeof fbq === 'function') {
          try {
            fbq('init', FB_PIXEL_ID);
            fbq('track', 'PageView');
          } catch (e) {
            console.warn('[Tracking] Facebook Pixel init error (non-critical):', e);
          }
        }
        
        // Helper para tracking com event_id (dedup com CAPI)
        window.trackFacebookEvent = function(eventName, params, eventId) {
          try {
            if (typeof fbq !== 'function') return;
            if (eventId) {
              // Enviar com event_id para dedup com CAPI
              fbq('track', eventName, {
                ...params,
                eventID: eventId
              });
            } else {
              fbq('track', eventName, params);
            }
          } catch (e) {
            console.warn('[Tracking] Facebook Pixel track error (non-critical):', e);
          }
        };
      } catch (error) {
        // Se Facebook Pixel falhar completamente, não quebra a página
        console.warn('[Tracking] Facebook Pixel initialization failed (non-critical):', error);
        window.trackFacebookEvent = function() {}; // Função vazia para não quebrar chamadas
      }
    </script>
      <noscript>
        <img height="1" width="1" style="display:none" 
          src={`https://www.facebook.com/tr?id=${FB_PIXEL_ID}&ev=PageView&noscript=1`}/>
      </noscript>
      </>
    )}
    <!-- End Facebook Pixel Code -->

    <style is:inline>
      /* Critical CSS for faster paint */
      body {
        margin: 0;
        padding: 0;
        background-color: #0A0A0A;
        color: #FFFFFF;
        /* Garantir que body não herde filtros/transformações problemáticas */
        filter: none !important;
        transform: none !important;
        will-change: auto !important;
        /* FIX SAFARI iOS: Usar -webkit-fill-available para altura correta */
        min-height: -webkit-fill-available;
      }
      
      /* Prevent FOUC - Show immediately but prevent flash */
      html {
        visibility: visible;
        opacity: 1;
        /* Garantir que html não herde propriedades problemáticas */
        filter: none !important;
        transform: none !important;
        /* FIX SAFARI iOS: Usar -webkit-fill-available para altura correta */
        min-height: -webkit-fill-available;
        height: -webkit-fill-available;
      }
      
      /* Prevent layout shift during image load */
      img {
        background-color: rgba(0, 0, 0, 0.3);
        /* Otimização de renderização */
        content-visibility: auto;
        contain-intrinsic-size: auto 500px;
      }

      /* Preload critical images */
      picture img[loading="eager"] {
        fetchpriority: high;
      }
      
      /* Smooth transitions */
      * {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      
      /* Garantir que main não herde propriedades problemáticas */
      main {
        filter: none !important;
        transform: none !important;
        will-change: auto !important;
        isolation: isolate;
        position: relative;
      }
      
      /* FIX SAFARI iOS: Solução agressiva - desabilitar tudo */
      @supports (-webkit-touch-callout: none) {
        @media (max-width: 768px) {
          * {
            animation: none !important;
            transition: none !important;
            transform: none !important;
            -webkit-transform: none !important;
            will-change: auto !important;
            filter: none !important;
            backdrop-filter: none !important;
          }
          
          html, body {
            background: #080707 !important;
            background-image: none !important;
            min-height: -webkit-fill-available !important;
            height: -webkit-fill-available !important;
          }
          
          *::before,
          *::after {
            display: none !important;
            content: none !important;
          }
        }
      }
    </style>
  </head>
  <body class="min-h-screen min-h-[100dvh] overflow-x-hidden safe-top safe-bottom">
    <slot />

    <!-- Smooth scroll polyfill for older browsers -->
    <script is:inline>
      if (!('scrollBehavior' in document.documentElement.style)) {
        import('https://unpkg.com/smoothscroll-polyfill@0.4.4/dist/smoothscroll.min.js').then(() => {
          window.__forceSmoothScrollPolyfill__ = true;
        });
      }
    </script>

    <!-- Tawk.to Chat Widget (Lazy Load) -->
    <script is:inline define:vars={{ TAWK_PROPERTY_ID, TAWK_WIDGET_ID }}>
      if (TAWK_PROPERTY_ID && TAWK_WIDGET_ID) {
        // Lazy load chat after page is interactive
        window.addEventListener('load', function() {
          setTimeout(function() {
            var Tawk_API = Tawk_API || {};
            var Tawk_LoadStart = new Date();
            var s1 = document.createElement("script");
            var s0 = document.getElementsByTagName("script")[0];
            s1.async = true;
            s1.src = 'https://embed.tawk.to/' + TAWK_PROPERTY_ID + '/' + TAWK_WIDGET_ID;
            s1.charset = 'UTF-8';
            s1.setAttribute('crossorigin', '*');
            s0.parentNode.insertBefore(s1, s0);
          }, 3000); // Load after 3 seconds for better performance
        });
      }
    </script>

    <!-- Global Event Tracking Helper -->
    <script is:inline>
      // Unified tracking function (usa /api/track com event_id e session_id)
      // ⚠️ CRÍTICO: Todo código de tracking está envolvido em try/catch para NUNCA quebrar a página
      (function() {
        try {
          if (typeof window === 'undefined') return;

          function ensureSessionId() {
            try {
              if (typeof window === 'undefined' || !window.localStorage) return '';
              const key = 'session_id';
              let id = localStorage.getItem(key);
              if (!id) {
                id = (crypto.randomUUID ? crypto.randomUUID() : 'sess_' + Math.random().toString(36).slice(2, 11));
                localStorage.setItem(key, id);
              }
              return id;
            } catch (e) {
              console.warn('[Tracking] Error ensuring session ID:', e);
              return '';
            }
          }

          function generateEventId() {
            try {
              return (crypto.randomUUID ? crypto.randomUUID() : 'evt_' + Math.random().toString(36).slice(2, 11));
            } catch (e) {
              console.warn('[Tracking] Error generating event ID:', e);
              return 'evt_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
            }
          }

          window.trackEvent = function(eventName, params) {
            try {
              if (typeof window === 'undefined') return;
              
              params = params || {};
              const sessionId = ensureSessionId();
              const eventId = generateEventId();

              const payload = {
                event_name: eventName,
                event_id: eventId,
                session_id: sessionId,
                page: window.location ? window.location.href : '',
                timestamp: Date.now(),
                ...params,
              };

              // Google Analytics 4
              if (typeof gtag === 'function') {
                try {
                  gtag('event', eventName, params);
                } catch (e) {
                  console.warn('[Tracking] GA4 error:', e);
                }
              }

              // Facebook Pixel
              if (typeof fbq === 'function') {
                try {
                  fbq('trackCustom', eventName, params);
                } catch (e) {
                  console.warn('[Tracking] Facebook Pixel error:', e);
                }
              }

              // Server-side tracking (não bloqueia se falhar)
              if (typeof fetch === 'function') {
                fetch('/api/track', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(payload),
                  keepalive: true,
                }).catch(function(err) {
                  // Silenciosamente ignora erros de rede
                  if (console && console.warn) {
                    console.warn('[Tracking] Server tracking failed (non-critical):', err);
                  }
                });
              }
            } catch (error) {
              // NUNCA propaga erro - tracking é non-critical
              if (console && console.warn) {
                console.warn('[Tracking] Non-critical tracking error:', error);
              }
            }
          };
        } catch (error) {
          // Se algo falhar na inicialização, pelo menos define uma função vazia
          window.trackEvent = function() {
            if (console && console.warn) {
              console.warn('[Tracking] Tracking not available');
            }
          };
        }
      })();
      
      // Track page visibility changes (for bounce rate) - wrapped in try/catch
      try {
        if (typeof document !== 'undefined' && document.addEventListener) {
          document.addEventListener('visibilitychange', function() {
            try {
              if (document.visibilityState === 'hidden' && typeof window !== 'undefined' && typeof window.trackEvent === 'function') {
                const timeOnPage = window.performance && window.performance.timing
                  ? Math.round((Date.now() - performance.timing.navigationStart) / 1000)
                  : 0;
                window.trackEvent('PageHidden', {
                  timeOnPage: timeOnPage,
                });
              }
            } catch (e) {
              // Silenciosamente ignora erros de tracking
              if (console && console.warn) {
                console.warn('[Tracking] PageHidden tracking error (non-critical):', e);
              }
            }
          });
        }
      } catch (error) {
        // Silenciosamente ignora se não conseguir adicionar o listener
        if (console && console.warn) {
          console.warn('[Tracking] Could not add visibility listener (non-critical):', error);
        }
      }
    </script>
  </body>
</html>
